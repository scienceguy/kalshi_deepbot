[Unit]
Description=Polymarket US Paper Trader
After=network-online.target n8n.service
Wants=network-online.target n8n.service

StartLimitIntervalSec=300
StartLimitBurst=5
[Service]
Type=notify
NotifyAccess=main
# The engine pings WATCHDOG=1 after every successful cycle (~15-20s) and from
# its sleep helper at least every 30s during long backoff sleeps (A10). A hung
# cycle therefore still trips the watchdog; a venue-outage backoff does not.
WatchdogSec=120
TimeoutStartSec=90
# Graceful shutdown: guard fast-loop stop (2s) + cancel venue resting orders
# (live mode) + ledger flush (5s) + session end + bridge stop, under this.
TimeoutStopSec=90
# A10: dedicated unprivileged service account. Create once:
#   sudo useradd --system --home /opt/superbot --shell /usr/sbin/nologin polybot
#   sudo usermod -a -G superbot polybot
#   sudo chown -R polybot:polybot /opt/superbot/local_data
#   sudo install -m 600 -o polybot -g polybot /opt/superbot/.env /opt/superbot/.env
# H4: Shared MemPalace directory at /var/lib/superbot/mempalace (superbot group, setgid)
User=polybot
Group=superbot
WorkingDirectory=/opt/superbot-releases/current
Environment=TMPDIR=/opt/superbot-releases/current/local_data
Environment=MEMPALACE_DIR=/var/lib/superbot/mempalace
ExecStart=/opt/superbot-releases/current/.venv/bin/python poly_us_trader.py --interval 15
# V2: on-failure + burst — a crash loop stops instead of spinning forever.
Restart=on-failure
RestartSec=15
StandardOutput=journal
StandardError=journal
# A10 hardening: no privilege escalation; read-only system; writes only to the
# state/ledger/log directory and the instance lock file (the leading "-" lets
# the lock path be absent on first start).
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/superbot-releases/current/local_data -/opt/superbot-releases/current/.lock_poly /var/lib/superbot/mempalace
PrivateTmp=true
# H4: Shared MemPalace directory at /var/lib/superbot/mempalace (superbot group, setgid)
# V2: 1024 fds was not enough for venue session + palace + DB + log.
LimitNOFILE=65536
# Measured RSS of sibling traders (kalshi dry ~306 MiB, collectors ~36 MiB);
# 1G is >3x headroom. MemPalace/Chroma can be large — measure before raising.
MemoryMax=1G
UMask=0002

[Install]
WantedBy=multi-user.target
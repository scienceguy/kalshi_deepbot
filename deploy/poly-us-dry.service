[Unit]
Description=Polymarket US Paper Trader
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
NotifyAccess=main
# The engine sends WATCHDOG=1 once per cycle (~15-20s). A hung cycle that
# never returns therefore trips the watchdog and systemd restarts the unit.
WatchdogSec=120
TimeoutStartSec=90
User=ubuntu
WorkingDirectory=/opt/superbot
ExecStart=/opt/superbot/.venv/bin/python poly_us_trader.py --interval 15
Restart=always
RestartSec=15
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

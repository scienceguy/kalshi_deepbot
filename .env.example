# Kalshi API credentials
KALSHI_KEY_ID=your_key_id_here
KALSHI_KEY_FILE=/path/to/kalshi_private.pem
# KALSHI_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----...

DRY_RUN=true
LOG_LEVEL=WARNING

# Live trading safety: MUST be "true" to enable --live mode.
# Default "false" so accidental `python trader.py --live` is blocked.
# Set to "true" ONLY when you explicitly intend to trade real money.
KALSHI_CONFIRM_LIVE=false

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY_FILE=/path/to/supabase_service_key

# n8n
# Prefer a protected key file over the inline value (see AGENTS.md → Credentials).
N8N_API_KEY_FILE=/data/data/com.termux/files/home/.secrets/n8n_api_key
# N8N_API_KEY=your_n8n_api_key
N8N_BASE_URL=http://127.0.0.1:5678

# Durable credential mirror (Bitwarden secure notes). Restore n8n creds with:
#   python scripts/n8n_creds_sync.py
BW_SECRET_STORE=/data/data/com.termux/files/home/.secrets/bw

# ── LLM trade evaluation (optional, 8-layer fallback) ────────────────────────
# Set any subset. Vertex AI uses ~/.config/gcloud/application_default_credentials.json
# when present; layers with no key/ADC are skipped; the DSH local gateway needs no
# key. Leave them all empty to run with no LLM gate at all.
VERTEX_PROJECT_ID=project-ba3748e7-0d3a-4268-b7c
VERTEX_LOCATION=global
VERTEX_MODEL=google/gemini-3.6-flash
NVIDIA_API_KEY=            # https://build.nvidia.com (also NVIDIA_API_KEY_FILE)
NVIDIA_MODEL=nvidia/nemotron-3.5-bolt-e4b
OPENROUTER_API_KEY=your_openrouter_key
GROQ_API_KEY=your_groq_key
DEEPSEEK_API_KEY=your_deepseek_key
OPENAI_API_KEY=your_openai_key
GEMINI_API_KEY=your_gemini_key
# Local gateway (no key). Ollama is intentionally not used.
DSH_BASE_URL=http://127.0.0.1:18900
LLM_EVALUATION_ENABLED=true
LLM_EVAL_FAIL_OPEN=true    # an LLM outage must not stop the bot trading
LLM_EVAL_MIN_PROBABILITY=0.65
LLM_EVAL_MIN_CONFIDENCE=0.45

# ── Pre-entry gates (gates.py) ───────────────────────────────────────────────
# SHADOW_MODE=true logs would-block decisions to gates_log.jsonl and never
# blocks. Set false to let the gates deny entries.
GATES_ENABLED=true
GATES_SHADOW_MODE=true
GATES_ATR_ENABLED=true
GATES_ATR_LOOKBACK=14
GATES_ATR_HURDLE=1.0
# true = measure the move needed AGAINST the position (0 for an in-the-money
# favourite). false = the spec-literal |strike-spot|, which flags every favourite.
GATES_ATR_SIDE_AWARE=true
# GATES_ATR_HURDLE_BTC=1.0
# GATES_ATR_HURDLE_ETH=1.0
# GATES_ATR_HURDLE_SOL=1.0
# GATES_ATR_HURDLE_XRP=1.0
# GATES_ATR_HURDLE_DOGE=1.0
# GATES_ATR_HURDLE_BNB=1.0
# GATES_ATR_HURDLE_HYPE=1.0
# GATES_ATR_HURDLE_ZEC=1.0
# GATES_ATR_HURDLE_NEAR=1.0
GATES_EV_ENABLED=true
GATES_MIN_EDGE=0.005
# true = charge the taker fee (conservative; an exit may cross the book)
GATES_FEE_TAKER=true
GATES_TIME_DECAY_ENABLED=true
GATES_HIGH_GAMMA_MINUTES=2.0
GATES_DENY_HIGH_GAMMA=false

# ── Stability gate (signals.py) ────────────────────────────────────────────────
# Fresh tickers with < STABILITY_LOOKBACK_MIN minutes of bid history: allow or
# block? true = fail-open (allow with warning); false = require history before
# trading. The old behaviour was always fail-open.
STABILITY_ENABLED=true
STABILITY_LOOKBACK_MIN=3
STABILITY_MIN_COVERAGE_MIN=2.5
STABILITY_MAX_YES_BID_CENTS=8
STABILITY_FAIL_OPEN=true

{
  "name": "SuperBot Retrain ML",
  "nodes": [
    {
      "id": "node_cron",
      "name": "Cron Every 6 Hours",
      "type": "n8n-nodes-base.cron",
      "typeVersion": 1,
      "position": [0, 0],
      "parameters": {
        "triggerTimes": {
          "item": [{"hour": [0, 6, 12, 18], "minute": 15}]
        }
      }
    },
    {
      "id": "node_retrain",
      "name": "Run ML Retrain",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [220, 0],
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:18711/retrain-ml",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{"name": "Content-Type", "value": "application/json"}]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({}) }}",
        "options": {"timeout": 1800000}
      }
    },
    {
      "id": "node_check",
      "name": "Check Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [440, 0],
      "parameters": {
        "jsCode": "const result = $json.result || {};\nif (result.success === false) {\n  return [{ json: { alert: true, text: \"ML retrain failed: \" + (result.error || \"unknown error\") } }];\n}\nreturn [{ json: { alert: false, text: \"ML retrain completed: \" + (result.message || \"ok\") } }];"
      }
    },
    {
      "id": "node_alert",
      "name": "Send Alert (on failure)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [660, 0],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPERBOT_ALERT_WEBHOOK_URL || \"http://127.0.0.1:9/superbot-alert-placeholder\" }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{"name": "Content-Type", "value": "application/json"}]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ subject: \"SuperBot ML Retrain Alert\", text: $json.text, severity: \"warning\" }) }}",
        "options": {}
      }
    }
  ],
  "connections": {
    "Cron Every 6 Hours": {"main": [[{"node": "Run ML Retrain", "type": "main", "index": 0}]]},
    "Run ML Retrain": {"main": [[{"node": "Check Result", "type": "main", "index": 0}]]},
    "Check Result": {"main": [[{"node": "Send Alert (on failure)", "type": "main", "index": 0}]]}
  },
  "settings": {},
  "staticData": null,
  "pinData": {},
  "meta": {"description": "ML model retrain: runs every 6 hours at :15, trains LightGBM on recent data"},
  "active": true
}
{
  "name": "SuperBot Daily Digest",
  "nodes": [
    {
      "id": "node_cron",
      "name": "Daily Cron (00:10 UTC)",
      "type": "n8n-nodes-base.cron",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "triggerTimes": {
          "item": [
            {
              "hour": 0,
              "minute": 10
            }
          ]
        }
      }
    },
    {
      "id": "node_digest",
      "name": "Run Daily Digest",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        220,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:18711/daily-digest",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={}",
        "options": {
          "timeout": 60000
        }
      }
    },
    {
      "id": "node_check",
      "name": "Check Alert",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "jsCode": "const result = .result || {};\nif (result.alert === true) {\n  return [{ json: { alert: true, text: result.digest_text || JSON.stringify(result) } }];\n}\nreturn []; // No alert, stop workflow"
      }
    },
    {
      "id": "node_alert",
      "name": "Send Alert",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        660,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPERBOT_ALERT_WEBHOOK_URL || \"http://127.0.0.1:9/superbot-alert-placeholder\" }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ subject: \"SuperBot Daily Digest\", text: $json.text, severity: \"info\" }) }}",
        "options": {}
      }
    }
  ],
  "connections": {
    "Daily Cron (00:10 UTC)": {
      "main": [
        [
          {
            "node": "Run Daily Digest",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run Daily Digest": {
      "main": [
        [
          {
            "node": "Check Alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Alert": {
      "main": [
        [
          {
            "node": "Send Alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {},
  "staticData": null,
  "pinData": {},
  "meta": {
    "description": "Daily digest cron: runs daily_digest.py at 00:10 UTC, posts summary to operator channel"
  },
  "active": true
}